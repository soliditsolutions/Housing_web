{
  "name": "housing",
  "private": true,
  "version": "0.1.0",
  "description": "Housing — plataforma PropTech de gestión de arriendos (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @housing/web",
    "build": "npm run build --workspace @housing/web",
    "start": "npm run start --workspace @housing/web",
    "lint": "npm run lint --workspace @housing/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "docx": "^9.7.1"
  },
  "allowScripts": {
    "@google/genai@2.11.0": true,
    "@prisma/engines@7.8.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
